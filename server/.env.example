PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/text-to-3d

# AI Model Provider: hunyuan3d (Default, 100% Free on Hugging Face) or meshy
AI_PROVIDER=hunyuan3d

# Optional: Hugging Face Token (free from https://huggingface.co/settings/tokens)
# Works even if left empty!
HF_TOKEN=

# Optional: Meshy API Key (if using AI_PROVIDER=meshy)
MESHY_API_KEY=

CLIENT_ORIGIN=http://localhost:5173
